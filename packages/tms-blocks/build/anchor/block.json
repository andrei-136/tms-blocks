          "duration": "0.2",
          "durationUnit": "s",
          "easing": "ease",
          "delay": "0",
          "delayUnit": "s"
        },
        "overrides": {},
        "states": {
          "hover": {
            "linked": true,
            "unlinkedProperties": []
          },
          "focusVisible": {
            "linked": true,
            "unlinkedProperties": []
          }
        }
      }
    }
