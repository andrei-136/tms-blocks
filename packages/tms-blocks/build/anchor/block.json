      "type": "object",
      "default": {}
    },
    "customBreakpoints": {
      "type": "array",
      "default": []
    },
    "customStyleHover": {
      "type": "object",
      "default": {}
    },
    "customStyleFocusVisible": {
      "type": "object",
      "default": {}
    },
    "renderBlock": {
      "type": "boolean",
      "default": true
    },
