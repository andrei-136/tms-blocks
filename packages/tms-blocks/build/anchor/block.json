    "isDynamic": {
      "type": "boolean",
      "default": false
    },
    "dynamicSteps": {
      "type": "array",
      "default": []
    },
    "dynamicPath": {
      "type": "string",
      "default": ""
    },
    "dynamicDateFormat": {
      "type": "string",
      "default": ""
    },
    "dynamicCommentsNoText": {
      "type": "string",
      "default": ""
